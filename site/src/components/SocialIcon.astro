---
// Filled brand icons for the header. GitHub and RSS come from simple-icons. LinkedIn
// is not in simple-icons any more, so its "in" glyph is drawn here on the same 24px grid.
import { siGithub, siRss } from 'simple-icons';

const paths = {
  github: siGithub.path,
  rss: siRss.path,
  linkedin:
    'M3 9h3.6v11.8H3Z M5 2.9a2.1 2.1 0 1 1 0 4.2 2.1 2.1 0 0 1 0-4.2Z M9.5 9h3.4v1.6c.5-.9 1.6-1.9 3.4-1.9 3.4 0 4 2.2 4 5.1V20.8h-3.6v-5.4c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8v5.5H9.5Z',
};

// Each glyph is scaled to about the same visual size, then centred. The values come from
// the measured bounding boxes: GitHub and RSS fill the grid, LinkedIn is about 17 units wide.
const transforms = {
  github: 'translate(12 12) scale(0.833) translate(-12 -12)',
  rss: 'translate(12 12) scale(0.833) translate(-12 -12)',
  linkedin: 'translate(12 12) scale(1.117) translate(-11.6 -11.85)',
};

interface Props {
  name: keyof typeof paths;
}

const { name } = Astro.props;
---

<svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
  <g transform={transforms[name]}>
    <path d={paths[name]} />
  </g>
</svg>

<style>
  .social-icon {
    width: 1.25rem;
    height: 1.25rem;
    display: block;
  }
</style>

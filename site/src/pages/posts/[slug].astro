---
import { render } from 'astro:content';
import { getPublishedPosts } from '../../lib/posts';
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import Cell from '../../components/Cell.astro';
import Chart from '../../components/Chart.astro';
import Note from '../../components/Note.astro';
import Pair from '../../components/Pair.astro';
import StatsTable from '../../components/StatsTable.astro';

// Components the posts can use. Keystatic lists the same names in keystatic.config.tsx.
const components = { Callout, Cell, Chart, Note, Pair, StatsTable };

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  // The collection id is the file name, so /posts/<slug>/ matches the old Quarto URLs.
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    <div class="post-meta">
      {post.data.date.toISOString().slice(0, 10)}
      {post.data.categories.map((c) => <span class="tag">{c}</span>)}
    </div>
    <Content components={components} />
  </article>
</Base>

---
import '../styles/global.css';
import SocialIcon from '../components/SocialIcon.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "The Bear's Toes" } = Astro.props;
const siteTitle = "The Bear's Toes";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === siteTitle ? title : `${title} · ${siteTitle}`}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteTitle} />
    <link rel="icon" href="/icon/profile-circle.png" />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/index.xml" />
    <!-- Lato for reading text, as the Quarto theme imported it. Fira Code stays for code. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,400;0,700;1,400&family=Inter:ital,wght@0,400;0,700;1,400&display=swap"
    />
    <!-- Apply a saved theme before first paint, so the page does not flash the other one. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved) document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">{siteTitle}</a>
      <nav>
        <a href="/">Blog</a>
        <a href="/about/">About</a>
        <a href="/cv/">CV</a>
        <button class="theme-toggle" type="button">
          <svg class="icon-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <nav>
        <a href="/about/">About</a>
        <a href="https://github.com/rtedwards/rtedwards.github.io/blob/main/LICENSE.md">License</a>
        <a class="icon-link" href="/index.xml" aria-label="RSS feed" title="RSS feed">
          <SocialIcon name="rss" />
        </a>
        <a class="icon-link" href="https://github.com/rtedwards" aria-label="GitHub" title="GitHub">
          <SocialIcon name="github" />
        </a>
        <a
          class="icon-link"
          href="https://www.linkedin.com/in/robert-edwards-3b98865/"
          aria-label="LinkedIn"
          title="LinkedIn"
        >
          <SocialIcon name="linkedin" />
        </a>
      </nav>
    </footer>
    <script>
      import { currentTheme, onThemeChange, setTheme, type Theme } from '../scripts/theme';
      import '../scripts/copy-code';

      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');

      const showNext = (theme: Theme) => {
        if (!button) return;
        const next: Theme = theme === 'dark' ? 'light' : 'dark';
        // CSS shows the moon when the next theme is dark, and the sun when it is light.
        button.dataset.next = next;
        button.setAttribute('aria-label', `Switch to ${next} theme`);
        button.title = `Switch to ${next} theme`;
      };

      button?.addEventListener('click', () => {
        setTheme(currentTheme() === 'dark' ? 'light' : 'dark');
      });

      showNext(currentTheme());
      onThemeChange(showNext);
    </script>
    <!-- Cloudflare Web Analytics. Cookie-free, so no consent banner is needed. -->
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "1a257cb2a13c4b63a087d96bc4d89131"}'></script>
  </body>
</html>
